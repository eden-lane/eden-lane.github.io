---
import "@fontsource-variable/open-sans";
const { title } = Astro.props;
---

<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
</head>
<body>
<style>
    body {
        background-color: #f8f8f8;
        font-family: 'Open Sans Variable', sans-serif;
        color: #4d4d4d;
    }

    main {
        margin: 64px auto;
        max-width: 600px;
    }

    h1 {
        font-size: 16px;
    }
</style>
<main>
  <h1>{title}</h1>
  <slot />
</main>
</body>
</html>
