---
// Get all the props that would normally go to an img tag
const { src, alt, width, height, ...props } = Astro.props;
---

<style>
  .zoomable-image-container {
    position: relative;
    display: inline-block;
    cursor: pointer;
  }

  .zoomable-image {
    display: block;
  }

  .zoomed-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    padding: 40px;
    box-sizing: border-box;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .zoomed-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .zoomed-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transform: scale(0.5);
    opacity: 0;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .zoomed-overlay.active .zoomed-image {
    transform: scale(1);
    opacity: 1;
  }

  .close-button {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.2);
    border: none;
    color: white;
    font-size: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .close-button:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }
</style>

<div class="zoomable-image-container">
  <img
    class="zoomable-image"
    src={src}
    alt={alt}
    width={width}
    height={height}
    {...props}
  />
  <div class="zoomed-overlay" id="zoomed-overlay">
    <img class="zoomed-image" src={src} alt={alt} />
    <button class="close-button" aria-label="Close">×</button>
  </div>
</div>

<script>
  // Find all zoomable image containers
  const containers = document.querySelectorAll(".zoomable-image-container");

  containers.forEach((container) => {
    const img = container.querySelector(".zoomable-image")!;
    const overlay = container.querySelector(".zoomed-overlay")!;
    const closeButton = container.querySelector(".close-button")!;

    // Open overlay on image click
    img.addEventListener("click", () => {
      overlay.classList.add("active");
      document.body.style.overflow = "hidden"; // Prevent scrolling when zoomed
    });

    // Close overlay on close button click
    closeButton.addEventListener("click", (e) => {
      e.stopPropagation();
      overlay.classList.remove("active");
      document.body.style.overflow = ""; // Restore scrolling
    });

    // Close overlay when clicking outside the image
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) {
        overlay.classList.remove("active");
        document.body.style.overflow = ""; // Restore scrolling
      }
    });

    // Close overlay on ESC key press
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && overlay.classList.contains("active")) {
        overlay.classList.remove("active");
        document.body.style.overflow = ""; // Restore scrolling
      }
    });
  });
</script>
