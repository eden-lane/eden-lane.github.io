---
import MainLayout from "../layouts/main.astro";
import Block from "../components/Block.astro";
import { LastfmBlock } from "../components/LastfmBlock/LastfmBlock";
import { AppsBlock } from "../components/AppsBlock";
import { Telegram } from "../components/icons/Telegram";
import { X } from "../components/icons/X";
import { Layers } from "../components/icons/Layers";
import { Github } from "../components/icons/Github";
import { getCollection } from "astro:content";
import { WidgetHeader } from "../components/WidgetHeader";
import { format } from "date-fns";

const posts = await getCollection("posts");
---

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  p {
    font-size: 14px;
  }

  hr {
    border: none;
    height: 1px;
    background-color: #e8e8e8;
    margin: 16px 0;
  }

  .links {
    font-size: 12px;
    display: flex;
    column-gap: 8px;

    & a {
      display: flex;
      column-gap: 2px;
      align-items: center;
      color: #4d4d4d;
      text-decoration: none;
      opacity: 0.65;
      transition: all 0.3s ease;

      &:hover {
        opacity: 1;
      }
    }
  }

  .blocks {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    row-gap: 8px;
    margin-top: 16px;
  }

  .block {
    width: 100%;
    opacity: 0;
    animation: fadeIn 0.5s ease forwards;
  }

  .block .header {
    font-size: 13px;
    font-weight: 600;
    padding: 0 8px;
  }

  .block .content {
    padding: 8px;
  }

  p {
    line-height: 1.5;
  }

  .link {
    display: inline-flex;
    column-gap: 2px;
    color: #1f8be4;
    text-decoration: none;
    line-height: 1.5;
  }

  .posts {
    display: flex;
    flex-direction: column;
    row-gap: 16px;
  }

  .post {
    font-size: 14px;
    padding: 8px;
    border-radius: 4px;
  }

  .post:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .post a {
    color: #1f8be4;
    text-decoration: none;
    display: flex;
    justify-content: space-between;
  }

  .post a span:last-child {
    color: #4d4d4d;
    font-size: 12px;
  }
</style>
<MainLayout title="eden lane">
  <p class="block" style="animation-delay: 0s">
    Hola! I'm a frontend engineer who loves to build things that make people's
    lives easier.
    <br />
    I'm currently working on a
    <a class="link" href="https://kona.to">
      <img src="/icons/kona.svg" alt="kona icon" width="16" height="16" />
      <span>Kona</span>
    </a>
    project in my spare time.
    <br />
    If you have any question or just want to say hi,<br /> feel free to reach out
    to me on:
  </p>
  <div class="links block" style="animation-delay: 0.2s">
    <a target="_blank" href="https://x.com/lane_en">
      <X width="16" height="16" />
    </a>
    <a target="_blank" href="https://t.me/eden_lane">
      <Telegram width="16" height="16" />
    </a>
    <a target="_blank" href="https://github.com/eden-lane">
      <Github width="16" height="16" />
    </a>
    <a target="_blank" href="https://layers.to/eden_lane">
      <Layers width="16" height="16" />
    </a>
  </div>
  <hr />
  <div class="blocks">
    <div class="block" style="animation-delay: 0.4s">
      <Block>
        <LastfmBlock client:load />
      </Block>
    </div>
    <div class="block" style="animation-delay: 0.6s">
      <Block>
        <AppsBlock client:load />
      </Block>
    </div>
    <div class="block" style="animation-delay: 0.8s">
      <Block>
        <span class="header">Posts</span>
        <div class="content">
          <div class="posts">
            {
              posts.map((post) => (
                <div class="post">
                  <a href={`/posts/${post.data.slug}`}>
                    <span>{post.data.title}</span>
                    <span class="date">
                      {format(post.data.date, "d MMMM yyyy")}
                    </span>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </Block>
    </div>
  </div>
</MainLayout>
